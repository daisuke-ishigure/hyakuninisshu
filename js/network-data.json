  "poems": {
    "1": {
      "first": "秋の田の かりほの庵の 苫をあらみ",
      "second": "我が衣手は 露にぬれつつ"
    },
    "2": {
      "first": "春過ぎて 夏来にけらし 白妙の",
      "second": "衣ほすてふ 天の香具山"
    },
    "3": {
      "first": "あしびきの 山鳥の尾の しだり尾の",
      "second": "ながながし夜を ひとりかも寝む"
    },
    "4": {
      "first": "田子の浦に うちいでてみれば 白妙の",
      "second": "富士の高嶺に 雪は降りつつ"
    },
    "5": {
      "first": "奥山に 紅葉踏み分け 鳴く鹿の",
      "second": "声聞く時ぞ 秋はかなしき"
    },
    "6": {
      "first": "かささぎの 渡せる橋に おく霜の",
      "second": "白きをみれば 夜ぞふけにける"
    },
    "7": {
      "first": "天の原 ふりさけみれば 春日なる",
      "second": "三笠の山に 出でし月かも"
    },
    "8": {
      "first": "わが庵は 都の辰巳 しかぞすむ",
      "second": "世をうぢ山と 人はいふなり"
    },
    "9": {
      "first": "花の色は うつりにけりな いたづらに",
      "second": "わが身よにふる ながめせしまに"
    },
    "10": {
      "first": "これやこの 行くも帰るも わかれては",
      "second": "しるもしらぬも 逢坂の関"
    },
    "11": {
      "first": "わたの原 八十島かけて 漕ぎ出でぬと",
      "second": "人にはつげよ あまのつり舟"
    },
    "12": {
      "first": "天つ風 雲のかよひ路 吹きとぢよ",
      "second": "をとめの姿 しばしとどめむ"
    },
    "13": {
      "first": "筑波嶺の 峰より落つる みなの川",
      "second": "こひぞつもりて 淵となりぬる"
    },
    "14": {
      "first": "陸奥の しのぶもぢずり 誰ゆゑに",
      "second": "乱れそめにし 我ならなくに"
    },
    "15": {
      "first": "君がため 春の野に出でて 若菜つむ",
      "second": "わが衣手に 雪は降りつつ"
    },
    "16": {
      "first": "立ち別れ いなばの山の 峰に生ふる",
      "second": "まつとし聞かば 今帰りこむ"
    },
    "17": {
      "first": "ちはやぶる 神代もきかず 竜田川",
      "second": "から紅に 水くくるとは"
    },
    "18": {
      "first": "住の江の 岸による波 よるさへや",
      "second": "夢のかよひ路 人目よくらむ"
    },
    "19": {
      "first": "難波潟 みじかき葦の ふしのまも",
      "second": "逢はでこの世を 過ぐしてよとや"
    },
    "20": {
      "first": "わびぬれば いまはたおなじ 難波なる",
      "second": "みをつくしても 逢はむとぞ思ふ"
    },
    "21": {
      "first": "今こむと いひしばかりに 長月の",
      "second": "有明の月を 待ち出でつるかな"
    },
    "22": {
      "first": "吹くからに 秋の草木の しをるれば",
      "second": "むべ山風を 嵐といふらむ"
    },
    "23": {
      "first": "月みれば ちぢにものこそ 悲しけれ",
      "second": "わが身一つの 秋にはあらねど"
    },
    "24": {
      "first": "このたびは 幣もとりあへず 手向山",
      "second": "もみぢのにしき 神のまにまに"
    },
    "25": {
      "first": "名にし負はば 逢坂山の さねかづら",
      "second": "人にしられで くるよしもがな"
    },
    "26": {
      "first": "小倉山 峰のもみぢ葉 心あらば",
      "second": "今ひとたびの みゆき待たなむ"
    },
    "27": {
      "first": "みかの原 わきて流るる いづみ川",
      "second": "いつ見きとてか 恋しかるらむ"
    },
    "28": {
      "first": "山里は 冬ぞさびしさ まさりける",
      "second": "人目も草も かれぬと思へば"
    },
    "29": {
      "first": "心当てに 折らばや折らむ 初霜の",
      "second": "おきまどはせる 白菊の花"
    },
    "30": {
      "first": "有明の つれなく見えし 別れより",
      "second": "あかつきばかり 憂きものはなし"
    },
    "31": {
      "first": "朝ぼらけ 有明の月と 見るまでに",
      "second": "吉野の里に 降れる白雪"
    },
    "32": {
      "first": "山川に 風のかけたる しがらみは",
      "second": "流れもあへぬ 紅葉なりけり"
    },
    "33": {
      "first": "久方の 光のどけき 春の日に",
      "second": "しづ心なく 花の散るらむ"
    },
    "34": {
      "first": "誰をかも 知る人にせむ 高砂の",
      "second": "松も昔の 友ならなくに"
    },
    "35": {
      "first": "人はいさ 心も知らず ふるさとは",
      "second": "花ぞ昔の 香に匂ひける"
    },
    "36": {
      "first": "夏の夜は まだ宵ながら あけぬるを",
      "second": "雲のいづこに 月やどるらむ"
    },
    "37": {
      "first": "白露に 風の吹きしく 秋の野は",
      "second": "つらぬきとめぬ 玉ぞ散りける"
    },
    "38": {
      "first": "忘らるる 身をば思はず 誓ひてし",
      "second": "人の命の 惜しくもあるかな"
    },
    "39": {
      "first": "浅茅生の 小野の篠原 しのぶれど",
      "second": "あまりてなどか 人の恋しき"
    },
    "40": {
      "first": "忍ぶれど 色に出でにけり 我が恋は",
      "second": "物や思ふと 人の問ふまで"
    },
    "41": {
      "first": "恋すてふ 我が名はまだき 立ちにけり",
      "second": "人しれずこそ 思ひそめしか"
    },
    "42": {
      "first": "契りきな かたみに袖を しぼりつつ",
      "second": "末の松山 波こさじとは"
    },
    "43": {
      "first": "逢ひ見ての のちの心に くらぶれば",
      "second": "昔は物を 思はざりけり"
    },
    "44": {
      "first": "逢ふことの 絶えてしなくは なかなかに",
      "second": "人をも身をも 恨みざらまし"
    },
    "45": {
      "first": "あはれとも いふべき人は 思ほえで",
      "second": "身のいたづらに なりぬべきかな"
    },
    "46": {
      "first": "由良のとを 渡る舟人 かぢを絶え",
      "second": "ゆくへも知らぬ 恋の道かな"
    },
    "47": {
      "first": "八重葎 しげれる宿の さびしきに",
      "second": "人こそ見えね 秋は来にけり"
    },
    "48": {
      "first": "風をいたみ 岩うつ波の おのれのみ",
      "second": "くだけて物を 思ふころかな"
    },
    "49": {
      "first": "御垣守 衛士のたく火の 夜はもえ",
      "second": "昼は消えつつ 物をこそ思へ"
    },
    "50": {
      "first": "君がため 惜しからざりし いのちさへ",
      "second": "長くもがなと 思ひけるかな"
    },
    "51": {
      "first": "かくとだに えやはいぶきの さしも草",
      "second": "さしも知らじな もゆる思ひを"
    },
    "52": {
      "first": "明けぬれば 暮るるものとは 知りながら",
      "second": "なほうらめしき 朝ぼらけかな"
    },
    "53": {
      "first": "嘆きつつ ひとり寝る夜の 明くる間は",
      "second": "いかに久しき ものとかは知る"
    },
    "54": {
      "first": "忘れじの ゆく末までは かたければ",
      "second": "今日を限りの 命ともがな"
    },
    "55": {
      "first": "滝の音は たえて久しく なりぬれど",
      "second": "名こそ流れて なほ聞こえけれ"
    },
    "56": {
      "first": "あらざらむ この世のほかの 思ひ出に",
      "second": "いまひとたびの 逢ふこともがな"
    },
    "57": {
      "first": "めぐり逢ひて 見しやそれとも わかぬ間に",
      "second": "雲隠れにし 夜半の月かな"
    },
    "58": {
      "first": "ありま山 猪名の笹原 風吹けば",
      "second": "いでそよ人を 忘れやはする"
    },
    "59": {
      "first": "やすらはで 寝なましものを 小夜更けて",
      "second": "かたぶくまでの 月を見しかな"
    },
    "60": {
      "first": "大江山 いく野の道の 遠ければ",
      "second": "まだふみもみず 天の橋立"
    },
    "61": {
      "first": "いにしへの 奈良の都の 八重桜",
      "second": "けふ九重に 匂ひぬるかな"
    },
    "62": {
      "first": "夜をこめて 鳥のそらねは はかるとも",
      "second": "よに逢坂の 関は許さじ"
    },
    "63": {
      "first": "いまはただ 思ひ絶えなむ とばかりを",
      "second": "人づてならで 言ふよしもがな"
    },
    "64": {
      "first": "朝ぼらけ 宇治の川霧 絶え絶えに",
      "second": "あらはれわたる 瀬々の網代木"
    },
    "65": {
      "first": "恨みわび ほさぬ袖だに あるものを",
      "second": "恋にくちなむ 名こそをしけれ"
    },
    "66": {
      "first": "もろともに あはれと思へ 山桜",
      "second": "花よりほかに 知る人もなし"
    },
    "67": {
      "first": "春の夜の 夢ばかりなる 手枕に",
      "second": "かひなく立たむ 名こそをしけれ"
    },
    "68": {
      "first": "心にも あらで憂き世に ながらへば",
      "second": "恋しかるべき 夜半の月かな"
    },
    "69": {
      "first": "嵐吹く 三室の山の 紅葉葉は",
      "second": "竜田の川の 錦なりけり"
    },
    "70": {
      "first": "さびしさに 宿を立ち出でて ながむれば",
      "second": "いづくも同じ 秋の夕暮"
    },
    "71": {
      "first": "夕されば 門田の稲葉 おとづれて",
      "second": "蘆のまろやに 秋風ぞ吹く"
    },
    "72": {
      "first": "音に聞く 高師の浜の あだ波は",
      "second": "かけじや袖の ぬれもこそすれ"
    },
    "73": {
      "first": "高砂の 尾の上の桜 咲きにけり",
      "second": "外山の霞 立たずもあらなむ"
    },
    "74": {
      "first": "憂かりける 人を初瀬の 山おろしよ",
      "second": "はげしかれとは 祈らぬものを"
    },
    "75": {
      "first": "契りおきし させもが露を いのちにて",
      "second": "あはれ今年の 秋もいぬめり"
    },
    "76": {
      "first": "わたの原 こぎいでてみれば 久方の",
      "second": "雲居にまがふ 沖つ白波"
    },
    "77": {
      "first": "瀬をはやみ 岩にせかるる 滝川の",
      "second": "われても末に あはむとぞ思ふ"
    },
    "78": {
      "first": "淡路島 かよふ千鳥の 鳴く声に",
      "second": "幾夜寝覚めぬ 須磨の関守"
    },
    "79": {
      "first": "秋風に たなびく雲の たえ間より",
      "second": "もれいづる月の 影のさやけさ"
    },
    "80": {
      "first": "長からむ 心もしらず 黒髪の",
      "second": "みだれてけさは 物をこそ思へ"
    },
    "81": {
      "first": "ほととぎす 鳴きつる方を ながむれば",
      "second": "ただ有明の 月ぞ残れる"
    },
    "82": {
      "first": "思ひわび さても命は あるものを",
      "second": "憂きにたへぬは 涙なりけり"
    },
    "83": {
      "first": "世の中よ 道こそなけれ 思ひ入る",
      "second": "山の奥にも 鹿ぞ鳴くなる"
    },
    "84": {
      "first": "長らへば またこのごろや しのばれむ",
      "second": "憂しと見し世ぞ 今は恋しき"
    },
    "85": {
      "first": "夜もすがら 物思ふころは 明けやらで",
      "second": "閨のひまさへ つれなかりけり"
    },
    "86": {
      "first": "嘆けとて 月やは物を 思はする",
      "second": "かこち顔なる わが涙かな"
    },
    "87": {
      "first": "村雨の 露もまだひぬ まきの葉に",
      "second": "霧たちのぼる 秋の夕暮"
    },
    "88": {
      "first": "難波江の 葦のかりねの ひとよゆゑ",
      "second": "みをつくしてや 恋ひわたるべき"
    },
    "89": {
      "first": "玉の緒よ 絶えなば絶えね ながらへば",
      "second": "忍ぶることの 弱りもぞする"
    },
    "90": {
      "first": "見せばやな 雄島のあまの 袖だにも",
      "second": "ぬれにぞぬれし 色はかはらず"
    },
    "91": {
      "first": "きりぎりす 鳴くや霜夜の さむしろに",
      "second": "衣かたしき ひとりかも寝む"
    },
    "92": {
      "first": "わが袖は 潮干に見えぬ 沖の石の",
      "second": "人こそ知らね かわくまもなし"
    },
    "93": {
      "first": "世の中は つねにもがもな 渚こぐ",
      "second": "あまの小舟の 綱手かなしも"
    },
    "94": {
      "first": "み吉野の 山の秋風 さ夜ふけて",
      "second": "ふるさと寒く 衣うつなり"
    },
    "95": {
      "first": "おほけなく 憂き世の民に おほふかな",
      "second": "わがたつ杣に 墨染の袖"
    },
    "96": {
      "first": "花さそふ 嵐の庭の 雪ならで",
      "second": "ふりゆくものは わが身なりけり"
    },
    "97": {
      "first": "来ぬ人を 松帆の浦の 夕なぎに",
      "second": "焼くやもしほの 身もこがれつつ"
    },
    "98": {
      "first": "風そよぐ ならの小川の 夕暮は",
      "second": "みそぎぞ夏の しるしなりける"
    },
    "99": {
      "first": "人もをし 人もうらめし あぢきなく",
      "second": "世を思ふゆゑに 物思ふ身は"
    },
    "100": {
      "first": "ももしきや ふるき軒ばの しのぶにも",
      "second": "なほあまりある 昔なりけり"
    }
  }
}