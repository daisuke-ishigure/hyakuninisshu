    },
    {
      "id": "early-heian",
      "name": "平安前期",
      "subtitle": "国風文化の芽生え",
      "description": "唐風から和風へ。かな文字が広まり、日本らしい歌が発展。"
    },
    {
      "id": "middle-heian",
      "name": "平安中期",
      "subtitle": "王朝文化の最盛期",
      "description": "貴族社会で恋や季節、美意識を競う和歌が花開く。"
    },
    {
      "id": "late-heian",
      "name": "平安後期",
      "subtitle": "院政・武士の台頭・末法思想",
      "description": "無常観や別れ、衰退への哀しみが色濃くなる。"
    },
    {
      "id": "kamakura",
      "name": "鎌倉時代",
      "subtitle": "武家社会の成立",
      "description": "貴族文化を受け継ぎながら、より深い人生観や無常観が表現される。"
    }
