# ※ hyakuninisshu.com は GitHub Pages で配信しており、このファイルは効かない（Apache ではないため）。
#   www なし・https への統一は GitHub Pages が行う。
#   古いURLからの転送は、転送用ページ（_tools/build-redirects.mjs で生成）と 404.html で行っている。
#   このファイルは旧ドメイン hyakuninisshu.sakura.ne.jp 側のサーバーに置いて使う（FTP でアップロードする）。
RewriteEngine on

# 旧ドメイン (hyakuninisshu.sakura.ne.jp) から新ドメインへの 301 リダイレクト
# - 末尾の #from_old_domain は、新ドメイン側(js/back-to-top.js)で「アドレスが変わりました」バナーを出すための目印。
#   # 以降はサーバーにも検索エンジンにも送られないので、Google から見た転送先は canonical と同じURLになる
#   （以前の ?from_old_domain=1 は、転送先が canonical と食い違っていた）。NE は # をエスケープさせないため。
# - 名前を変えた・削除したページと古い歌のURLは、転送用ページを経由させず、最終的なページへ直接転送する
#   （新ドメインの転送用ページ = _tools/build-redirects.mjs の REDIRECTS と同じ対応）。
# - QSD は元の ? 以降を付け直さないため（# の後ろに ? が付いて壊れるのを防ぐ）。? 以降がある場合は最後のルールで残す。

# 古い歌のページ（/no17chihayaburu/ など）→ 現行の歌のページ（/17.html）
RewriteRule ^no([0-9]{1,3})[a-zA-Z0-9_-]*/?(index\.html)?$ https://hyakuninisshu.com/$1.html#from_old_domain [R=301,L,NE,QSD]

RewriteCond %{THE_REQUEST} ^.*/index.html
RewriteRule ^(.*)index.html$ https://hyakuninisshu.com/$1#from_old_domain [R=301,L,NE,QSD]

RewriteRule ^bozumekuri\.html$ https://hyakuninisshu.com/memory.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^yakushoku\.html$ https://hyakuninisshu.com/kanshoku.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^kajin-sort\.html$ https://hyakuninisshu.com/kajin-zukan.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^hudanagashi\.html$ https://hyakuninisshu.com/hudanagashi-flash.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^karuta_tokkun\.html$ https://hyakuninisshu.com/karuta.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^leaflet-map\.html$ https://hyakuninisshu.com/utamakura.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^takaramono-sugoroku\.html$ https://hyakuninisshu.com/mubeyama-sugoroku.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^discontinued_sanjurokkasen\.html$ https://hyakuninisshu.com/sanjurokkasen.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^cosmos_test\.html$ https://hyakuninisshu.com/cosmos.html#from_old_domain [R=301,L,NE,QSD]
RewriteRule ^sanjurokkasen-zukan\.html$ https://hyakuninisshu.com/sanjurokkasen.html#from_old_domain [R=301,L,NE,QSD]

# それ以外はすべて同じパスへ。? 以降があればそのまま残す
RewriteCond %{QUERY_STRING} ^(.+)$
RewriteRule ^(.*)$ https://hyakuninisshu.com/$1?%1#from_old_domain [R=301,L,NE]
RewriteRule ^(.*)$ https://hyakuninisshu.com/$1#from_old_domain [R=301,L,NE,QSD]

<IfModule mod_deflate.c>
# mod_deflateを有効にする記述
SetOutputFilter DEFLATE

# 古いMozillaなどの古いブラウザでは無効にする。例外としてIEは有効にする
BrowserMatch ^Mozilla/4\.0[678] no-gzip
BrowserMatch ^Mozilla/4 gzip-only-text/html
BrowserMatch \bMSI[E] !no-gzip !gzip-only-text/html

# 画像は2重圧縮になるので圧縮しない
SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|ico)$ no-gzip dont-vary
SetEnvIfNoCase Request_URI _\.utxt$ no-gzip

# 圧縮するファイル形式を列挙
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/atom_xml
AddOutputFilterByType DEFLATE application/x-javascript
AddOutputFilterByType DEFLATE application/x-httpd-php
</IfModule>
