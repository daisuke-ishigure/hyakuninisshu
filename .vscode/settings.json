{
  "files.associations": {
    "utamakuralocation.js": "json",
    "utamakuralocation_en.js": "json"
  },
  // 拡張機能「Fold on Open」（prantlf.fold-on-open）用：HTML を開いたとき、
  // 系図の SVG（<!-- #region KEIZU:START -->〜<!-- #endregion KEIZU:END -->）を畳んだ状態にする
  "foldOnOpen.targets": ["AllMarkerRegions"],
  "foldOnOpen.enableFiles": ["**/*.html"],
  // HTML の整形（VS Code 標準）：長い行を自動で折り返さず、<ruby> の中は書いたまま残す。
  // 折り返しで <ruby> の中や前後に改行が入ると、ブラウザでは空白として表示されてしまうため
  "html.format.wrapLineLength": 0,
  "html.format.unformatted": "wbr,ruby,rt,rp"
}

